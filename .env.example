# ============================================
# مثال متغيرات البيئة — منصة مراسي
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================

# ---------- التطوير المحلي فقط ----------
# مسار قاعدة SQLite المحلية (المسار النسبي يُحل من مجلد prisma/)
DATABASE_URL="file:../db/custom.db"

# مفتاح توقيع جلسات JWT — ولّد قيمة عشوائية قوية لبيئة الإنتاج
# (على Vercel: أضفه من Project Settings > Environment Variables)
AUTH_SECRET="change-me-to-a-long-random-secret"

# ---------- الإنتاج على Vercel + Turso ----------
# رابط قاعدة Turso — من أمر: turso db show <اسم-القاعدة> --url
# مثال: libsql://marasa-yourname.turso.io
TURSO_DATABASE_URL=""

# توكن الوصول للقاعدة — من أمر: turso db tokens create <اسم-القاعدة>
TURSO_AUTH_TOKEN=""
